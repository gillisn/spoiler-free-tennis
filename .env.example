# ---- RapidAPI: Tennis API - ATP WTA ITF (provider: matchstat.com) ----
# From https://rapidapi.com/jjrm365-kIFr3Nx_odV/api/tennis-api-atp-wta-itf -> Pricing tab -> subscribe (Basic = 50 req/day free)
# then Endpoints tab -> any endpoint -> Code Snippets -> copy the key/host shown there.
RAPIDAPI_KEY=
RAPIDAPI_HOST=tennis-api-atp-wta-itf.p.rapidapi.com

# Tournament ids are specific to this provider AND to one edition/year —
# find the right ones via the tournament-lookup endpoints in the dashboard
# (try getTournamentSeasons or similar) and search for "US Open" 2026.
# ATP and WTA are separate ids even for the same physical tournament.
TOURNAMENT_ID_ATP=
TOURNAMENT_ID_WTA=

# ---- Optional: only needed for USE_DRAWS=1 local testing (README section 7) ----
# The Draws endpoint (which has break points) is looked up by NAME + year,
# not season_id — e.g. TOURNAMENT_NAME_ATP="U.S. Open - New York". Confirm
# the exact string works with a real test call before relying on it.
TOURNAMENT_NAME_ATP=
TOURNAMENT_NAME_WTA=
TOURNAMENT_YEAR=2026

USE_DRAWS=1
TOURNAMENT_NAME_ATP=U.S. Open - New York
TOURNAMENT_YEAR=2026

# ---- Trial scope ----
TOURNAMENT_LABEL=US Open

# ---- Supabase (free Postgres) ----
# From your Supabase project -> Settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Instagram Graph API (Meta) — OPTIONAL ----
# Leave both blank to skip auto-posting entirely: the cron still runs, saves
# the digest, and returns { imageUrl, caption } in its JSON response so you
# can grab the graphic and post it to Instagram yourself. Fill these in only
# if/when you want it posted automatically instead.
# The Instagram Business Account ID (not your @handle) and a long-lived access token
# with instagram_business_content_publish + instagram_business_basic scopes.
IG_BUSINESS_ACCOUNT_ID=
IG_ACCESS_TOKEN=

# ---- Site ----
# Public base URL of the deployed site, used to build the graphic's image URL
# (Instagram fetches it directly when auto-posting; you'd open it in a
# browser and save it yourself otherwise).
NEXT_PUBLIC_SITE_URL=https://spoilerfreetennis.com

# ---- Cron security ----
# Random string you make up. Set the same value in Vercel env vars.
# Protects /api/cron/daily from being triggered by randoms.
CRON_SECRET=change-me-to-a-random-string
